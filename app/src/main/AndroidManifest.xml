<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Overlay windows (config editor + detection highlights) are added in M4/M6. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScreenClicker">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Invisible trampoline for the system's screen-capture consent dialog: the
          dialog's result can only reach an Activity, and the panel and the editor are
          services. Launched from the background (allowed with the overlay permission)
          the first time a run or a capture needs a session that is not live.
        -->
        <activity
            android:name=".capture.CaptureConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
          The privileged core: reads the screen (canTakeScreenshot) and injects taps
          (dispatchGesture). See res/xml/accessibility_service_config.xml.
        -->
        <service
            android:name=".accessibility.ClickerAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
          Fast capture backend: mirrors the display into an ImageReader for the
          MediaProjection capturer. Started only after the user consents.
        -->
        <service
            android:name=".capture.CaptureProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name=".tile.ClickerTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
          Always-available floating panel: start/stop scripts and jump into the rule
          editor without opening the app. Foreground service so it survives the user
          being in another app; it never captures the screen itself.
        -->
        <service
            android:name=".overlay.ControlPanelService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating control panel for starting and stopping user-configured screen-click scripts, and opening the rule editor, without leaving the app being automated." />
        </service>

        <!--
          Floating rule editor over the target app: rectangle windows plus a toolbar.
          A foreground service only to keep those windows alive while the user is
          actively editing; it captures nothing by itself.
        -->
        <service
            android:name=".overlay.ConfigOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Fullscreen rect editor for configuring screen-click rules; visible only while the user is actively editing a rule." />
        </service>

    </application>

</manifest>
