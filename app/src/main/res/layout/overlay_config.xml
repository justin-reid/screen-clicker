<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen configuration editor drawn over the target app. The editor view is
  transparent except for the rule's rectangles; the toolbar is an opaque strip.
  The window itself is FLAG_NOT_FOCUSABLE (no IME needed) and laid out in screen
  coordinates including the status bar, so view coordinates == screenshot pixels.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.screenclicker.overlay.RectEditorView
        android:id="@+id/editor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#E6101018"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/roleSearch"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FF80CBC4"
                    android:text="@string/overlay_role_search" />

                <Button
                    android:id="@+id/roleTemplate"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFD54F"
                    android:text="@string/overlay_role_template" />

                <Button
                    android:id="@+id/roleClick"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FF90CAF9"
                    android:text="@string/overlay_role_click" />
            </LinearLayout>
        </HorizontalScrollView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/actionCapture"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/overlay_capture" />

                <Button
                    android:id="@+id/actionCheck"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/overlay_check" />

                <Button
                    android:id="@+id/actionSave"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFA5D6A7"
                    android:text="@string/overlay_save" />

                <Button
                    android:id="@+id/actionCancel"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFEF9A9A"
                    android:text="@string/overlay_cancel" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:text="@string/overlay_status_hint" />
    </LinearLayout>
</LinearLayout>
