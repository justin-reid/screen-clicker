<?xml version="1.0" encoding="utf-8"?>
<!--
  canTakeScreenshot (API 30+) is what enables AccessibilityService.takeScreenshot();
  canRetrieveWindowContent powers foreground-app detection via rootInActiveWindow.

  canPerformGestures is what enables AccessibilityService.dispatchGesture(): the
  service capability CAPABILITY_CAN_PERFORM_GESTURES exists only when this attribute
  is true, and dispatchGesture() returns false without it. It is not implied by the
  others, and it was missing here until round 16 — which is why every tap this app
  ever injected was declined by the system before it reached the screen.

  All three are required for the core loop, so this service config is load-bearing.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100" />
