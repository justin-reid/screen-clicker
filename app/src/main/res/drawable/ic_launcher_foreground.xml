<?xml version="1.0" encoding="utf-8"?>
<!-- Screen Clicker: crosshair / target with a tap point — "watch, find, tap". -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- outer ring -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:pathData="M54,28 A26,26 0 1,0 54.01,28 Z" />
    <!-- crosshair ticks (N/E/S/W) -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M54,14 L54,22 M86,54 L78,54 M54,94 L54,86 M22,54 L30,54" />
    <!-- center tap point -->
    <path
        android:fillColor="#FFB300"
        android:pathData="M54,47 A7,7 0 1,0 54.01,47 Z" />
</vector>
